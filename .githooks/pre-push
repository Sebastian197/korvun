#!/bin/bash
# .githooks/pre-push — git's own push door (R12-H8, B2).
#
# Git runs this hook for every `git push` from THIS checkout, whatever
# shell form invoked it (keywords, wrappers, backslashes, absolute
# paths: none of the shapes that fool a command regex exist here).
# What it does NOT stop, declared: `--no-verify` and a moved
# `core.hooksPath` (git's own escape hatches — the session hook blocks
# their spellings, nothing blocks them from another terminal);
# removing or un-executing this hook (git silently skips a hook that
# is not executable); and the freshness gap of a fresh clone or
# worktree, where the tracked verdict's mtime is reset (see the check
# script's header; B5, the SHA binding, is filed to the next train).
# Install with `make install-hooks` (a symlink under .git/hooks; the
# repo sets no core.hooksPath so graphify's post-commit keeps working).
#
# The decision itself lives in ONE place: scripts/adversary-gate-check.sh.
# A missing or non-executable check script blocks the push (fail closed).
ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
CHECK="$ROOT/scripts/adversary-gate-check.sh"
if [ ! -x "$CHECK" ]; then
  echo "BLOCKED by adversary gate: $CHECK is missing or not executable — nothing is authorized." >&2
  exit 2
fi
exec "$CHECK" "$ROOT"
