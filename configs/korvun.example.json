{
  "channels": [
    {
      "type": "telegram",
      "mode": "polling",
      "token_env": "TELEGRAM_BOT_TOKEN"
    },
    {
      "type": "webhook",
      "token_env": "KORVUN_WEBHOOK_SECRET",
      "webhook": {
        "bind": "127.0.0.1:8090",
        "path": "/webhook",
        "outbound_url": "https://example.com/korvun/replies"
      }
    }
  ],
  "brains": [
    {
      "name": "default",
      "sensitivity": "public",
      "dispatch": "fanout",
      "policy": {
        "kind": "priority",
        "order": ["ollama", "groq"]
      },
      "models": [
        {
          "provider": "ollama",
          "model_id": "llama3.2",
          "locality": "local",
          "base_url": "http://localhost:11434"
        },
        {
          "provider": "groq",
          "model_id": "llama-3.3-70b-versatile",
          "locality": "cloud",
          "api_key_env": "GROQ_API_KEY"
        }
      ]
    }
  ],
  "routes": [
    {"channel": "telegram", "brain": "default"},
    {"channel": "webhook", "brain": "default"}
  ]
}
