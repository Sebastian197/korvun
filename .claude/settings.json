{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-attribution.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/quality-gate.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/adversary-gate.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push -d *)",
      "Bash(git push * -d *)",
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)",
      "Bash(git push * v0.*)",
      "Bash(git push * v1.*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push * --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push * -f*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git push *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git * core.hooksPath*)",
      "Bash(git * core.hookspath*)",
      "Bash(gh pr merge*)",
      "Bash(gh release create*)",
      "Bash(gh release edit*)",
      "Bash(gh release delete*)",
      "Bash(gh repo delete*)",
      "Bash(gh api -X*)",
      "Bash(gh api * -X*)",
      "Bash(gh api --method*)",
      "Bash(gh api * --method*)",
      "Bash(gh api -f *)",
      "Bash(gh api * -f *)",
      "Bash(gh api -F *)",
      "Bash(gh api * -F *)",
      "Bash(gh api --field*)",
      "Bash(gh api * --field*)",
      "Bash(gh api --raw-field*)",
      "Bash(gh api * --raw-field*)",
      "Bash(gh api --input*)",
      "Bash(gh api * --input*)",
      "mcp__plugin_github_github__merge_pull_request",
      "mcp__plugin_github_github__delete_repository"
    ],
    "ask": [
      "Bash(rm -r*)",
      "Bash(rm -R*)",
      "Bash(rm -fr*)",
      "Bash(rm -fR*)",
      "Bash(rm --recursive*)",
      "Bash(rm * -r*)",
      "Bash(rm * -R*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec rm*)",
      "Bash(git reset *--ha*)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout * -- *)",
      "Bash(git checkout .*)",
      "Bash(git checkout -f*)",
      "Bash(git restore *)",
      "Bash(git switch -f*)",
      "Bash(git switch *--discard-changes*)",
      "Bash(git branch -D*)",
      "Bash(git branch * -D*)",
      "Bash(git branch *--force*)",
      "Bash(git branch -f*)",
      "Bash(git branch * -f *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git worktree remove -f*)",
      "Bash(git worktree remove * -f*)",
      "Bash(git worktree remove *--force*)",
      "Bash(git update-ref -d*)",
      "Bash(git tag -d*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git reflog expire*)",
      "Bash(git gc *--prune*)"
    ]
  }
}
