{
  "name": "korvun-website",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/apply-webpackbar-compat.mjs",
    "start": "docusaurus start",
    "dev": "docusaurus start",
    "build": "docusaurus build --out-dir .vitepress/dist",
    "preview": "docusaurus serve --dir .vitepress/dist",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test src/theme/storytelling.test.mjs src/redirect-legacy-host.test.mjs scripts/webpackbar-compat.test.mjs",
    "test:e2e": "playwright test",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:motion": "node scripts/check-motion.mjs",
    "check:parity": "node scripts/check-parity.mjs",
    "check:release-facts": "node scripts/check-release-facts.mjs",
    "check": "npm run test:unit && npm run typecheck && npm run check:release-facts && npm run check:parity && npm run build && npm run check:dist && npm run check:docs && npm run check:contrast && npm run check:motion"
  },
  "overrides": {
    "serialize-javascript": "7.0.5",
    "uuid": "11.1.1",
    "nanoid": "3.3.18"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@playwright/test": "1.62.1",
    "playwright-core": "1.62.1",
    "typescript": "7.0.2",
    "webpack": "5.110.1"
  }
}
